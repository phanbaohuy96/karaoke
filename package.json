{
  "name": "karaoke-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "express": "latest",
    "ws": "latest",
    "qrcode": "latest",
    "dotenv": "latest",
    "nanoid": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "tsx": "latest",
    "concurrently": "latest",
    "@types/express": "latest",
    "@types/ws": "latest",
    "@types/qrcode": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
